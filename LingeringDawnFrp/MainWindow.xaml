<Window x:Class="LingeringDawnFrp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="LingeringDawn Frp"
        Width="940"
        Height="700"
        MinWidth="820"
        MinHeight="600"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== 头部 ==================== -->
        <Grid Grid.Row="0" Margin="2,0,2,14">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource PrimaryBrush}">
                    <TextBlock Text="LD"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LingeringDawn Frp" Style="{StaticResource TitleText}" />
                    <TextBlock Text="frp 隧道客户端 · 配置由面板下发"
                               Style="{StaticResource SubtitleText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText"
                           Style="{StaticResource SubtitleText}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <Border Style="{StaticResource StatusPill}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="9"
                                 Height="9"
                                 Fill="{StaticResource NeutralBrush}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                        <TextBlock x:Name="StatusTextBlock"
                                   Text="已停止"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== 面板入口（原内置 WebView 区域） ==================== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="面板" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Style="{StaticResource SubtitleText}" TextWrapping="Wrap">
                        已不再内嵌浏览器，改为调用系统默认浏览器打开，登录状态由浏览器维护。
                        访问密钥请在面板的「用户中心」查看，复制后粘贴到下方。
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Button x:Name="BrowserTokenButton"
                            Content="浏览器获取密钥"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"
                            Click="BrowserTokenButton_Click"
                            ToolTip="在浏览器里登录面板后，自动把访问密钥填入下方并保存" />
                    <Button x:Name="OpenPanelButton"
                            Content="打开面板"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"
                            Click="OpenPanelButton_Click"
                            ToolTip="在浏览器中打开面板（原「用户中心」入口已合并到这里）" />
                    <Button x:Name="CheckUpdateButton"
                            Content="检查更新"
                            Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0"
                            Click="CheckUpdateButton_Click"
                            ToolTip="查询 GitHub 上是否有新版本" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 连接配置 ==================== -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="连接配置" Style="{StaticResource SectionTitleText}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="访问密钥" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                        <Grid>
                            <TextBox x:Name="TokenTextBox"
                                     Visibility="Collapsed"
                                     Style="{StaticResource InputTextBox}"
                                     TextChanged="TokenTextBox_TextChanged"
                                     ToolTip="16 位十六进制，可在面板用户中心查看" />
                            <PasswordBox x:Name="TokenPasswordBox"
                                         Style="{StaticResource InputPasswordBox}"
                                         PasswordChanged="TokenPasswordBox_PasswordChanged"
                                         ToolTip="16 位十六进制，可在面板用户中心查看" />
                        </Grid>
                        <CheckBox x:Name="ShowTokenCheckBox"
                                  Content="显示密钥"
                                  Style="{StaticResource ModernCheckBox}"
                                  Margin="0,10,0,0"
                                  Checked="ShowTokenCheckBox_Checked"
                                  Unchecked="ShowTokenCheckBox_Unchecked" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="节点 ID" Style="{StaticResource FieldLabelText}" Margin="0,0,0,6" />
                        <TextBox x:Name="NodeIdTextBox"
                                 Width="120"
                                 Style="{StaticResource InputTextBox}"
                                 TextChanged="NodeIdTextBox_TextChanged"
                                 ToolTip="正整数，默认 1（面板未提供节点列表接口，需手动填写）" />
                    </StackPanel>
                </Grid>

                <Border Height="1" Background="{StaticResource BorderBrushSoft}" Margin="0,16,0,14" />

                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoStartCheckBox"
                                  Content="开机自启"
                                  Style="{StaticResource ModernCheckBox}"
                                  Checked="AutoStartCheckBox_Checked"
                                  Unchecked="AutoStartCheckBox_Unchecked" />
                        <CheckBox x:Name="AutoReconnectCheckBox"
                                  Content="断线自动重连"
                                  Style="{StaticResource ModernCheckBox}"
                                  Margin="22,0,0,0"
                                  Checked="AutoReconnectCheckBox_Checked"
                                  Unchecked="AutoReconnectCheckBox_Unchecked"
                                  ToolTip="frpc 意外退出时按退避间隔自动重试，最多 5 次；手动停止不会触发" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="StartButton"
                                Content="一键启动"
                                Style="{StaticResource SuccessButton}"
                                Width="124"
                                Click="StartButton_Click" />
                        <Button x:Name="StopButton"
                                Content="停止隧道"
                                Style="{StaticResource DangerButton}"
                                Width="124"
                                Margin="8,0,0,0"
                                Click="StopButton_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 运行日志 ==================== -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="18,14,14,10">
                    <TextBlock Text="运行日志" Style="{StaticResource SectionTitleText}" Margin="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="LogPathText"
                                   Style="{StaticResource SubtitleText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   MaxWidth="420"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="ClearLogButton"
                                Content="清空"
                                Style="{StaticResource SmallGhostButton}"
                                Click="ClearLogButton_Click" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource LogBackgroundBrush}"
                        CornerRadius="0,0,13,13"
                        Padding="4">
                    <RichTextBox x:Name="LogBox"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource LogInfoBrush}"
                                 FontFamily="Consolas, Microsoft YaHei UI"
                                 FontSize="12.5"
                                 Padding="8"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 IsDocumentEnabled="False" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
